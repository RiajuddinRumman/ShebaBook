generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())

  bookings        Booking[]
  providerProfile ProviderProfile?

  @@map("users")
}

model ProviderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  city        String
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings ServiceListing[]
  bookings Booking[]

  @@index([city])
  @@map("provider_profiles")
}

model ServiceListing {
  id              String   @id @default(uuid())
  providerId      String
  title           String
  description     String
  category        String
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([providerId])
  @@index([category, active])
  @@map("service_listings")
}

model Booking {
  id         String        @id @default(uuid())
  customerId String
  /// Denormalised from the listing so Postgres can enforce per-provider
  /// exclusivity with an exclusion constraint; listingId never changes.
  providerId String
  listingId  String
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  listing  ServiceListing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([providerId, startsAt, endsAt])
  @@index([listingId, startsAt, endsAt])
  @@index([customerId, startsAt, endsAt])
  @@index([customerId, status])
  @@map("bookings")
}
